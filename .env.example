# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# PEFLARMO ADMIN EMAIL & SMTP CONFIGURATION
# ==========================================
# Primary SMTP host (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST="smtp.gmail.com"

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT="587"

# Use SSL/TLS (true for port 465, false for port 587/STARTTLS)
SMTP_SECURE="false"

# SMTP authentication credentials
SMTP_USER="peflarmo@gmail.com"
SMTP_PASS="your-app-password-or-smtp-key"

# Sender address shown on admin security & OTP emails
SMTP_FROM="Peflarmo Security <peflarmo@gmail.com>"

# Official Peflarmo Admin Notification & Alert Email
ADMIN_OFFICIAL_EMAIL="peflarmo@gmail.com"
